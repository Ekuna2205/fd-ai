# Copy to .env and replace every CHANGE_ME. Never commit .env.
# The backend and docker-compose.yml both read this file. See README for PowerShell commands that fill the secrets.

# --- PostgreSQL ---
POSTGRES_USER=faceguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=faceguard
# Host used when the backend runs on your machine (outside Docker). Docker Compose overrides this to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full SQLAlchemy URL overrides the POSTGRES_* parts.
# DATABASE_URL=

# --- Development extras (docker-compose.dev.yml publishes these on 127.0.0.1 only) ---
# POSTGRES_PORT=5432
# BACKEND_PORT=8000

# --- Gateway (the only service that publishes a port) ---
GATEWAY_PORT=8080
# HTTPS (docker-compose.tls.yml): set GATEWAY_PORT=80 and GATEWAY_TLS_PORT=443, and APP_BASE_URL=https://your.domain
# GATEWAY_TLS_PORT=443

# --- Backend ---
# At least 32 random characters. The app refuses to start with a short or placeholder value.
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
# Public URL of the frontend; used for the link in password-reset e-mails.
# With Docker Compose the app is served by the gateway on GATEWAY_PORT. When running `npm run dev`, use http://localhost:5173.
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# E-mails that are always administrators (promoted at sign-up/sign-in). Use it to recover admin access.
ADMIN_EMAILS=
# The first account becomes Administrator; set false to block further self-registration afterwards.
REGISTRATION_ENABLED=true
# API docs at /api/docs. Keep false in production. docker-compose.dev.yml turns it on at http://localhost:8000/api/docs
DOCS_ENABLED=false
LOG_LEVEL=INFO
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DETECT_PER_MINUTE=600
RATE_LIMIT_VERIFY_PER_MINUTE=30

# --- Media limits (enforced by the API; the UI reads them from /api/face/capabilities) ---
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=30

# --- Datasets and challenges ---
# Where uploaded datasets are stored (Docker sets /srv/data and mounts a volume). Outside Docker: any writable folder.
# DATA_DIR=./backend/data
CHALLENGE_TTL_SECONDS=120
# Single-process mode only (run.py / root Dockerfile): folder with the built web app. Empty = ../frontend/dist if present.
# FRONTEND_DIR=
RATE_LIMIT_DATASET_PER_MINUTE=300
RATE_LIMIT_CHALLENGE_PER_MINUTE=20

# --- Privacy ---
# Delete verification results older than this many days (checked at startup; schedule scripts/purge_retention.py daily).
# 0 = keep until the owner deletes them. Raw images and videos are never stored either way.
RETENTION_DAYS=0

# --- Face detection ---
# auto = YuNet CNN detector when its model file is installed (scripts/fetch_models.py does that), else the Haar cascade.
# yunet = require YuNet (startup fails without it). haar = always the older Haar cascade.
FACE_DETECTOR=auto

# --- Models and liveness decisions ---
# A model can only be activated if its evaluation used at least this many test samples.
MIN_EVAL_SAMPLES=200
# The ACTIVE model decides REAL/FAKE. Scores within +/- this margin of the model's threshold stay UNCERTAIN.
LIVENESS_UNCERTAINTY_MARGIN=0.1
# true = no REAL/FAKE verdict for images that fail the quality checks (the score is still shown).
LIVENESS_REQUIRE_QUALITY=true
# Largest ONNX file accepted by the "Register a trained model" form (the Nginx gateway allows 60 MB bodies).
MAX_MODEL_MB=50

# --- Production safety ---
# production: rejects wildcard CORS and warns if API docs are enabled. Compose defaults to production.
# When running the backend on your own machine for development, set ENVIRONMENT=development.
ENVIRONMENT=production

# --- Label Studio (NOT implemented: no code reads these yet) ---
# LABEL_STUDIO_URL=
# LABEL_STUDIO_TOKEN=
# LABEL_STUDIO_PROJECT_ID=

# --- Password-reset e-mail (optional) ---
# Without SMTP_HOST and SMTP_FROM, POST /api/auth/forgot-password answers 503 ("not configured") and nothing is sent.
# You need an SMTP account: host, port, username, password and a verified sender address (e.g. from your mail provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
